# Template. build-omarchy-arm.sh generates the real one at $W/provision/config.env
# from the questionnaire answers (or the defaults with --yes), and puts it into
# the provisioning ISO. This file is only for manual passes.
VM_USER="builder"
VM_PASSWORD="builder"
VM_FULLNAME="Omarchy ARM"
VM_EMAIL="usuario@ejemplo.com"
VM_HOSTNAME="omarchy"
VM_TIMEZONE="Europe/Madrid"
VM_KEYMAP="es"
VM_XKB="es"
VM_LOCALE="en_US.UTF-8"
VM_LOCALE_EXTRA="es_ES.UTF-8"
DISK="/dev/vda"
DIST_OLD_USER="builder"
DIST_NEW_USER="omarchy"
HACER_TOOLS="si"
HACER_LIBRES="si"

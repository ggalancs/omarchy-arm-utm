#!/bin/bash
# Shortcut for SSH-ing into the VM during development.
#   OM_HOST=192.168.64.20 OM_USER=builder ./scripts/omssh "command"
# The IP can be obtained with:  utmctl ip-address "Omarchy ARM"
: "${OM_USER:=builder}"
# No apostrophe in the message. The word part of ${var:?word} goes through
# quote removal, so the one in "VM's" opened a single-quoted string that ran to
# the end of the file: `bash -n` on this script has been failing since it was
# written, and nothing noticed because every CI selector matches '*.sh' and
# this is the one shell program under scripts/ without the suffix.
: "${OM_HOST:?OM_HOST is missing (the IP of the VM)}"
exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR -o ConnectTimeout=10 "$OM_USER@$OM_HOST" "$@"
